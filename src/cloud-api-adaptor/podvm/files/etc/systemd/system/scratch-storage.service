[Unit]
Description=Configurable Scratch Storage Setup for Kata Agent
DefaultDependencies=no

Requires=systemd-repart.service
After=systemd-repart.service

Requires=dev-disk-by\x2dlabel-trusted_store.device
After=dev-disk-by\x2dlabel-trusted_store.device

Before=kata-agent.service sysinit.target
ConditionPathExists=/run/peerpod/scratch-space.marker

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/setup-scratch-storage

[Install]
WantedBy=sysinit.target
